QMainWindow {
    background-color: #FFFFFF;
}

QWidget {
    color: #1e293b;
}

QLabel {
    font-size: 12px;
}

QLineEdit {
background-color: white;
border: 1.5px solid #dddddd;
border-radius: 8px;
padding: 5px;

}

#header_layout {
    background-color: #ebf1fa;
    min-height: 75px;
    max-height: 75px;
}

#back_btn {
    background-color: transparent;
}

#header_text {
    color: #3c5670;
    font-size: 29px;
    font-weight: bold;
}

#confirm_btn {
    background-color: #22588d;
    font-weight: bold;
    font-size: 18px;
    color: #FCFFFF;
    padding: 5px;
    border-radius: 11px;
    
}

#inputDetails_layout {
    background-color: #FFFFFF;
}

#progress_layout{
    background-color: #FFFFFF;
    min-height: 25px;
    max-height: 25px;
}

#personal_details_label {
    color: black;
    font-size: 18px;
    font-weight: bold;
    padding: 7px;
}

#first_name_label {
    color: black;
    font-size: 12px;
    padding: 2px;
}

#last_name_label {
    color: black;
    font-size: 12px;
    padding: 2px;
}

#phone_no_label{
    color: black;
    font-size: 12px;
    padding: 2px;
}

#email_address_label {
    color: black;
    font-size: 12px;
    padding: 2px;
}
